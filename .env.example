# Copy this file to .env and fill in your local PostgreSQL credentials.
# These variables are ONLY used by scripts/load_data.py and
# scripts/export_analytics.py (the one-time SQL -> CSV export step).
#
# The Streamlit dashboard (dashboard/app.py) does NOT read this file and
# does NOT need database credentials - it only reads the CSVs in
# data/analytics_outputs/, which is what makes it deployable to
# Streamlit Cloud with zero secrets configured.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=amazon_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here
